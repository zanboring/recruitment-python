# ============================================================
# Docker Compose 部署配置模板
# ============================================================
# 用法：
#   docker compose up -d --build      # 访问 http://localhost:8080
#
# ⚠️ 两条必须先读的说明
#
# 一、为什么是 `.env` 而不是 `config.env`
#   两者服务于不同的运行形态，**不要混用**：
#     - `config.env` —— 源码模式（start.bat / uvicorn）的配置，由 app/config.py 读取；
#     - `.env`        —— Compose 变量插值**唯一**读取的文件。
#   这正是本项目踩过的坑：JWT_SECRET 明明写在 config.env 里，`docker compose up`
#   却报「未设置」直接退出 —— 因为插值根本不看 config.env。
#   （「Compose 只读 .env」是它的既定行为，不是本项目缺陷；写进模板是为了避免
#     部署方按源码模式的经验配错文件。docker-compose.yml 里的报错文案也已指向本文件。）
#
# 二、如果 `.env` 已经存在（本项目源码模式默认就有）
#   **不要整份覆盖** —— 那会丢掉里面已有的 DB_* 等配置。
#   只需把下面的「必填」项（JWT_SECRET）**补充**进已有的 `.env` 即可。
#   （config.env 里已有一份 48 字节的随机 JWT_SECRET，可直接复制过来。）
#
# 本文件被 .gitignore 与 .dockerignore 双重排除：不会进版本库、也不会进镜像。

# ---------- 必填 ----------

# JWT 签名密钥。
# 留空、或使用占位值（含 change_me / changeme / your_ / placeholder / example /
# sample / todo / 32chars / replace_me / insert_ 等字样）都会被应用拒绝启动
# —— validate_production_settings() 在任何环境都不放行空密钥与占位值。
# 生成（任选其一）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
JWT_SECRET=

# ---------- 可选：AI 密钥（留空自动降级，不影响启动）----------

# 留空则 AI 走三级降级链：云端 → 本地 Ollama → 规则引擎
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=

# ---------- 可选：多副本与 Redis ----------

# 后端 worker 数（默认 2）。
# 这是 Redis 后端「真正承担职责」的前提：单 worker 时进程内实现本就正确，
# 2 worker 后限流计数/爬虫日配额/熔断状态必须跨进程共享，否则配额翻倍。
# 本机单机调试可设 1。
# BACKEND_WORKERS=2

# 限流计数后端：redis（默认，compose 自带 Redis 服务）/ memory
# Redis 不可用时自动降级内存并记 warning，请求不中断。
# RATE_LIMIT_BACKEND=redis

# 采集日配额 / 域名节流后端：redis / memory
# ⚠️ 这一项直接关系**对招聘站点的合规承诺**：内存实现下每个 worker 各算一份配额，
# 2 副本时实际访问量翻倍、承诺不再成立；域名节流同理（跨进程仍可能同时打同一域名）。
# QUOTA_BACKEND=redis

# ---------- ⚠️ 多副本下的定时任务（部署前务必读）----------

# 多 worker 时，进程内 APScheduler（定时爬取 / 日报）与 job_checker（岗位存活核查）
# 会在**每个 worker 内各自启动** → 定时任务重复触发 N 次，对招聘站点的访问压力
# 翻倍。这是多副本的真实代价（进程内调度器无法感知兄弟进程）。
#
# 两种处理方式：
#   a) 生产环境：关掉进程内调度，改由外部 cron 调用 API 触发：
#        SCHEDULED_CRAWL_ENABLED=false
#        REPORT_ENABLED=false
#        # 外部 cron 示例（需管理员 token）：
#        #   curl -X POST http://localhost:8080/api/crawler/start \
#        #        -H "Authorization: Bearer <token>" \
#        #        -H "Content-Type: application/json" \
#        #        -d '{"keyword":"Java","city":"北京","platforms":["boss"]}'
#   b) 演示 / 开发环境：接受重复触发，保持默认 true。
#
# SCHEDULED_CRAWL_ENABLED=true
# REPORT_ENABLED=true

# ---------- 前端端口 ----------
# 对外端口由 docker-compose.yml 的 `ports: "8080:80"` 决定；
# 如需改端口，请改那里（此处不参与插值）。
