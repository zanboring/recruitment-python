APP_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=recruitment_db
# 数据库类型：mysql | postgres | sqlite
# DB_TYPE=mysql
# PostgreSQL 示例（DB_TYPE=postgres，DB_PORT=5432）
DB_NAME=recruitment_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=your_jwt_secret_base64
JWT_EXPIRATION=86400000

# ========== AI 对话模型（OpenAI 兼容协议）==========
# 主服务商：deepseek | zhipu。另一个自动作为备选（多供应商容灾）
AI_PROVIDER=deepseek

# DeepSeek（默认主模型）。密钥留空则自动降级到本地 Ollama
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
# 思考模式强度：none 关闭（默认）/ low / high / max
DEEPSEEK_REASONING_EFFORT=none

# 智谱 GLM（备选服务商，可留空）
ZHIPUAI_API_KEY=
ZHIPUAI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPUAI_MODEL=glm-4-flash

# ========== 知识库语义检索（向量 RAG）==========
# auto：配置了智谱密钥走云端 embedding-3，否则自动改用本地 Ollama
EMBEDDING_ENABLED=true
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=embedding-3
EMBEDDING_API_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
EMBEDDING_DIMENSIONS=1024
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 知识库检索策略：auto | semantic | keyword | hybrid
RAG_RETRIEVAL_STRATEGY=auto

# 工具识别前置过滤：仅在「短消息且无领域信号」时跳过，避免每条消息都多花一次
# LLM 调用（实测约 2.9s/次）。发现漏判可设为 false 整体回退。
AI_TOOL_PREFILTER_ENABLED=true
AI_TOOL_PREFILTER_MAX_CHARS=24

# 知识库自动入库：关闭后 AI 回答不再沉淀进知识库（避免自学习回路固化错误）
AI_AUTO_LEARN_ENABLED=true

# 输出长度上限（成本与延迟的硬边界）。不设上限时云端成本不可控、
# 本地模型可能让用户等上几分钟。
AI_MAX_OUTPUT_TOKENS=1024
AI_ANALYSIS_MAX_OUTPUT_TOKENS=2048
AI_TOOL_DETECT_MAX_TOKENS=128

# AI 用量与成本统计（落 ai_usage 表，接口 GET /api/model/usage）
AI_USAGE_LOG_ENABLED=true
USAGE_PRICE_DEEPSEEK_INPUT=2.0
USAGE_PRICE_DEEPSEEK_OUTPUT=8.0
USAGE_PRICE_ZHIPU_INPUT=0.1
USAGE_PRICE_ZHIPU_OUTPUT=0.1
USAGE_PRICE_LOCAL=0.0

# ========== 本地模型（Ollama）==========
# 本地不是「一个备胎」，而是按能力分工的两个模型：
#   OLLAMA_MODEL       语言类 —— 对话生成、分析报告（语言表达与事实准确性更好）
#   OLLAMA_CODE_MODEL  代码类 —— 工具识别、JSON 结构化抽取（准确率相同但快一倍）
#   OLLAMA_TOOL_MODEL  显式指定工具识别模型；留空则自动用 CODE_MODEL，再回退 MODEL
# 分工依据来自实测，可执行 `python scripts/bench_local_models.py` 在本机复现。
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_TOOL_MODEL=

CRAWL_MAX_JOBS=200
CRAWL_RETRY_TIMES=4
CRAWL_DELAY_MIN=12
CRAWL_DELAY_MAX=18
CRAWL_TIMEOUT=45
# 可选代理（http://user:pass@host:port），留空直连
# CRAWL_PROXY=
# 风控信号(429/captcha等)出现后随机拉大延迟的倍率区间下限/上限
# CRAWL_ADAPTIVE_DELAY_FACTOR=[8,16]

SERVER_PORT=8080

# 限流维度是否采信 X-Forwarded-For。默认 false（安全优先）。
# 该头客户端可伪造，开启后需确保前方代理会重写它，否则可被绕过。
RATE_LIMIT_TRUST_FORWARDED_FOR=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== 采集节流与合规（跨任务层）==========
# 注意与上面的 CRAWL_DELAY_MIN/MAX 区分：那两个管「一次爬取内部」相邻请求的间隔；
# 下面这些管「任务之间」——同一域名会不会被并发访问、今天还能请求多少次。
# 同一域名两次请求的最小间隔（秒）。0 = 不限制。
CRAWL_DOMAIN_MIN_INTERVAL=20
# 单个平台每日最大请求次数（按北京日期计）。0 = 不限制。
CRAWL_DAILY_QUOTA_PER_PLATFORM=2000
# 是否检查 robots.txt（命中 Disallow 会记 WARNING 并写进任务 message）
CRAWL_ROBOTS_CHECK_ENABLED=true
# 命中 robots.txt 禁止时是否直接拒绝该平台。
# 默认 false（只告警）是刻意取舍：默认阻断会让人撞上「配置全对却跑不起来」。
CRAWL_ROBOTS_STRICT=false
# 定时爬取的组间随机间隔（秒），默认 2~6 分钟；配合打乱顺序，
# 避免 18 组任务背靠背连跑形成过于规律的流量形状。
SCHEDULED_CRAWL_GAP_MIN=120
SCHEDULED_CRAWL_GAP_MAX=360

# ========== Redis 缓存（可选，不配置则用内存缓存）==========
# REDIS_URL=redis://localhost:6379/0

# ------- 浏览器采集通道（油猴脚本 / 浏览器扩展，默认关闭）-------
# 在用户真实浏览器里采集并回传，走真实 IP 与真实指纹，不存在集中访问特征。
# 留空即关闭该入口（接口直接返回 403）—— 默认安全。
# 生成令牌：python -c "import secrets;print(secrets.token_urlsafe(24))"
BROWSER_COLLECT_TOKEN=
# 单次提交上限，防脚本写错一次灌进几万条
BROWSER_COLLECT_MAX_BATCH=500

# ========== 定时任务（时间均为北京时间）==========
# 触发时间原先写死在 app/scheduler.py，现改为配置；改完需重启服务
SCHEDULED_CRAWL_ENABLED=true
SCHEDULED_CRAWL_HOUR=2
SCHEDULED_CRAWL_MINUTE=0
REPORT_ENABLED=true
REPORT_HOUR=6
REPORT_MINUTE=30

# ========== 日报推送 Webhook（可选，默认关闭）==========
# 不配置则只在本地生成 Excel，不发任何外部请求
# REPORT_WEBHOOK_TYPE：wecom（企业微信机器人）/ dingtalk（钉钉机器人）/ generic（通用 JSON）
# REPORT_WEBHOOK_ENABLED=true
# REPORT_WEBHOOK_TYPE=wecom
# REPORT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# REPORT_WEBHOOK_TOP_N=5

