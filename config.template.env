# ============================================================
#  通用版配置文件模板（可移植软件）
#
#  用法（三选一，按优先级）：
#    1. 发布软件：把本文件复制为 config.env 放在 软件(RecSys.exe) 同目录
#    2. 源码运行：复制为项目根目录 config.env
#    3. 或直接使用 .env（本地调试版默认）
#
#  配置好的 config.env 跟着软件走，换电脑只需拷贝软件目录 + 填你的 Key，
#  不需要安装 Python / MySQL / Ollama —— 全部内置或自动降级。
# ============================================================

# ------- 数据库（默认 SQLite 零依赖，无需修改）-------
# 换 PostgreSQL：DB_TYPE=postgres + 下方 host/port/name/user/pass
DB_TYPE=sqlite
DB_NAME=data/recsys.db
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=recsys
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# ------- 安全（生产必改）-------
# 至少 32 字符随机串；生成：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_secret_32chars_min

# ------- AI（核心：填一个即可用，两个都填有容灾）-------
# DeepSeek（智能对话 / 分析报告 / 技能识别）
# 免费额度申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 智谱 GLM（视觉识别 / 链接导入需要 —— 这两个功能强依赖 GLM-4V-Free 视觉模型）
# 申请：https://open.bigmodel.cn
ZHIPUAI_API_KEY=

# 未配置任何 Key 时：AI 自动降级为本地规则引擎（基础查询可用，无 LLM 回答）

# ------- 可选增强 -------
# 本机装了 Ollama（本地大模型）则启用三级降级中的本地级
OLLAMA_ENABLED=false
# 本机装了 Redis 则启用分布式缓存（不装自动内存缓存）
REDIS_URL=
# 岗位存活核查（默认开，后台低速扫库，可关）
JOB_CHECKER_ENABLED=true

# ------- 定时任务（时间均为北京时间，改完重启软件生效）-------
# 定时爬取：每天按「关键词 × 城市」批量采集
SCHEDULED_CRAWL_ENABLED=true
SCHEDULED_CRAWL_HOUR=2
SCHEDULED_CRAWL_MINUTE=0
# 自动化日报：默认排在爬取之后，当天重复触发幂等
REPORT_ENABLED=true
REPORT_HOUR=6
REPORT_MINUTE=30

# ------- 日报推送（可选，默认关闭）-------
# 不配置就只在本地产出 Excel，不发任何外部请求。
# REPORT_WEBHOOK_TYPE：wecom（企业微信机器人）/ dingtalk（钉钉机器人）/ generic（通用 JSON）
# REPORT_WEBHOOK_URL：机器人 Webhook 地址，示例
#   企业微信  https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
#   钉钉      https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
REPORT_WEBHOOK_ENABLED=false
REPORT_WEBHOOK_TYPE=wecom
REPORT_WEBHOOK_URL=
# 推送消息里最多列几个城市/平台/技能，避免被机器人截断
REPORT_WEBHOOK_TOP_N=5

# ------- 采集节流与合规（跨任务层）-------
# 说明：CRAWL_DELAY_MIN/MAX 管的是「一次爬取内部」相邻请求的间隔；
# 下面这些管的是「任务之间」——同一域名会不会被并发访问、今天还能请求多少次。
# 同一域名两次请求的最小间隔（秒）。0 = 不限制。
CRAWL_DOMAIN_MIN_INTERVAL=20
# 单个平台每日最大请求次数（按北京日期计）。0 = 不限制。
CRAWL_DAILY_QUOTA_PER_PLATFORM=2000
# 是否检查 robots.txt（命中 Disallow 会记 WARNING）
CRAWL_ROBOTS_CHECK_ENABLED=true
# 命中 robots.txt 禁止时是否直接拒绝该平台。
# 默认 false（只告警）是刻意取舍：默认阻断会让人撞上「配置全对却跑不起来」，
# 且分不清是自己配错还是站点不允许。对外交付/有合规要求时设为 true。
CRAWL_ROBOTS_STRICT=false
# 定时爬取的组间随机间隔（秒），默认 2~6 分钟。
# 18 组任务原先背靠背连跑、一小时内打完一整套，流量形状过于规律；
# 插入随机间隔并打乱顺序后，一轮会自然摊开到一两个小时。
SCHEDULED_CRAWL_GAP_MIN=120
SCHEDULED_CRAWL_GAP_MAX=360

# ------- 版本与更新检查 -------
# 「检查更新」比对的是 GitHub Release 的 tag 与 app/version.py 的 APP_VERSION，
# 所以发版时 tag 必须与 APP_VERSION 一致（如 v1.0.0），否则会提示「已是最新」。
UPDATE_REPO=zanboring/recruitment-python
# 默认开启，但只在点「检查更新」时才发请求（不做启动时自动联网）
UPDATE_CHECK_ENABLED=true
