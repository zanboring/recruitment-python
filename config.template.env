# ============================================================
#  通用版配置文件模板（可移植软件）
#
#  用法（三选一，按优先级）：
#    1. 发布软件：把本文件复制为 config.env 放在 软件(RecSys.exe) 同目录
#    2. 源码运行：复制为项目根目录 config.env
#    3. 或直接使用 .env（本地调试版默认）
#
#  配置好的 config.env 跟着软件走，换电脑只需拷贝软件目录 + 填你的 Key，
#  不需要安装 Python / MySQL / Ollama —— 全部内置或自动降级。
# ============================================================

# ------- 数据库（默认 SQLite 零依赖，无需修改）-------
# 换 PostgreSQL：DB_TYPE=postgres + 下方 host/port/name/user/pass
DB_TYPE=sqlite
DB_NAME=data/recsys.db
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=recsys
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# ------- 安全（生产必改）-------
# 至少 32 字符随机串；生成：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_secret_32chars_min

# ------- AI（核心：填一个即可用，两个都填有容灾）-------
# DeepSeek（智能对话 / 分析报告 / 技能识别）
# 免费额度申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 智谱 GLM（视觉识别 / 链接导入需要 —— 这两个功能强依赖 GLM-4V-Free 视觉模型）
# 申请：https://open.bigmodel.cn
ZHIPUAI_API_KEY=

# 未配置任何 Key 时：AI 自动降级为本地规则引擎（基础查询可用，无 LLM 回答）

# ------- 可选增强 -------
# 本机装了 Ollama（本地大模型）则启用三级降级中的本地级
OLLAMA_ENABLED=false
# 本机装了 Redis 则启用分布式缓存（不装自动内存缓存）
REDIS_URL=
# 岗位存活核查（默认开，后台低速扫库，可关）
JOB_CHECKER_ENABLED=true
