# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试
.pytest_cache/
.coverage

# 数据库
*.db
*.sqlite3

# 日志
logs/
*.log

# 环境变量
.env

# 开发过程产物（AI 工具审计 / 提示词记录，不进仓库）
_archive/

# 协作检查器的本机状态（记录"上次看到哪版收件箱"，每个工作区各不相同，
# 入库只会制造无意义的冲突）
collab/.state/

# 自动化日报生成的 Excel 产物
reports/daily/

# 前端构建产物与依赖（只提交源码；部署时 npm run build 生成 dist）
frontend/node_modules/
frontend/dist/

# 用户自定义配置（含 API Key，模板才是入库对象）
config.env
env/config.env

# PyInstaller 打包产物（本地生成，发布走 GitHub Release 附件）
build/
dist/
# 用 --distpath/--workpath 指定别的输出目录时（例如为了绕开被占用的 dist/）
# 也必须忽略，否则构建产物会被误提交
build_*/
dist_*/
*.spec.bak
